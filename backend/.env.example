# Copy to .env and fill in. Never commit .env.
ALLOWED_ORIGINS=*
GEOCODE_COUNTRY_CODES=ca
GEOCODE_USER_AGENT=LivingFloodMap-TbayHackathon/1.0
# Hackathon Gemini API key (small shared quota; failed requests count too)
HACKATHON_API_KEY=
# Set to 0 to test uploads locally without spending quota
LLM_ENABLED=1
# Only set to 1 when regenerating data/seeds/ with Gemini (~415 requests, run once)
BUILTIN_USE_LLM=0
